<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="cancel_schedule">
                <settings>
                    <confirm>
                        <message translate="true">Clear Publish at and Unpublish at of the selected items?</message>
                        <title translate="true">Cancel schedule</title>
                    </confirm>
                    <url path="mageos_schedule/schedule/cancel"/>
                    <type>cancel_schedule</type>
                    <label translate="true">Cancel schedule</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="cms_block_columns">
        <column name="publish_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Publish at</label>
            </settings>
        </column>
        <column name="unpublish_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Unpublish at</label>
            </settings>
        </column>
    </columns>
</listing>
