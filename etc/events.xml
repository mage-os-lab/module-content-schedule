<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="cms_page_save_before">
        <observer name="mageos_content_schedule" instance="MageOS\ContentSchedule\Observer\NormalizeDates"/>
        <observer name="mageos_content_schedule_redirect"
                  instance="MageOS\ContentSchedule\Observer\ValidateRedirect"/>
    </event>
    <event name="cms_block_save_before">
        <observer name="mageos_content_schedule" instance="MageOS\ContentSchedule\Observer\NormalizeDates"/>
    </event>
</config>
