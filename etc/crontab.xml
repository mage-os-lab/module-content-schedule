<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="mageos_content_schedule_apply" instance="MageOS\ContentSchedule\Cron\Apply" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <!-- Daily, in the time zone of the default config scope, as every Magento cron schedule -->
        <job name="mageos_content_schedule_remind" instance="MageOS\ContentSchedule\Cron\Remind" method="execute">
            <schedule>0 7 * * *</schedule>
        </job>
    </group>
</config>
